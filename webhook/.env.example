# ── Google OAuth (calendar-only scope) ──────────────────────────────────────────
# Mint these once with scripts/mint-calendar-token.py (see README.md).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxx

# ── Webhook plumbing ─────────────────────────────────────────────────────────────
# Public HTTPS URL Google posts change-notifications to (must be a verified domain).
WEBHOOK_URL=https://YOUR_SUBDOMAIN.example.com/api/calendar-webhook
# Shared secret echoed back by Google in the X-Goog-Channel-Token header; we verify it.
WEBHOOK_SECRET=generate-a-long-random-string
# Protects the renew-watch cron endpoint (Vercel sends it as a Bearer token).
CRON_SECRET=generate-another-long-random-string

# ── Mirror behavior ──────────────────────────────────────────────────────────────
SOURCE_CALENDAR_ID=primary
MIRROR_INVITE_EMAIL=you@work-example.com
TIMEZONE=America/Los_Angeles
MIRROR_TITLE=Personal — Busy
MIRROR_DESC=Personal commitment. Time protected.
LOOKAHEAD_DAYS=14
BUFFER_MINUTES=15
MIN_DURATION_MIN=20
WEEKDAYS_ONLY=true
SKIP_KEYWORDS=
SKIP_CALENDAR_IDS=hebcal,holiday,birthdays

# ── Supabase (state: syncToken + watch channel) ─────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx
