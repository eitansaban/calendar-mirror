# ── Required ──────────────────────────────────────────────────────────────────
# The address to invite onto each mirror block (e.g. your work calendar).
MIRROR_INVITE_EMAIL=you@work-example.com

# ── Optional (sensible defaults shown) ──────────────────────────────────────────
# Calendar to read from. "primary" = the authenticated account's main calendar.
SOURCE_CALENDAR_ID=primary

# Where failure/staleness alerts are emailed. Defaults to MIRROR_INVITE_EMAIL.
# ALERT_EMAIL=you@personal-example.com

# IANA timezone name.
TIMEZONE=America/Los_Angeles

# Title + description used for every mirror block. Keep these generic — the whole
# point is that the target calendar never sees your real event details.
MIRROR_TITLE=Personal — Busy
MIRROR_DESC=Personal commitment. Time protected.

# How far ahead to mirror, and the buffer added before/after each event.
LOOKAHEAD_DAYS=14
BUFFER_MINUTES=15

# Ignore events shorter than this many minutes.
MIN_DURATION_MIN=20

# Only mirror Mon–Fri events. Set to false to mirror every day.
WEEKDAYS_ONLY=true

# Alert if no successful run in this many hours.
STALE_THRESHOLD_HOURS=8

# Skip source events whose title contains any of these words (comma-separated).
# Example: SKIP_KEYWORDS=gym,run,workout,lunch
SKIP_KEYWORDS=

# Skip events organized by these calendars (substring match on organizer email).
SKIP_CALENDAR_IDS=hebcal,holiday,birthdays

# Optional path overrides (default: alongside the script).
# TOKEN_PATH=/abs/path/token.json
# CREDS_PATH=/abs/path/client_secret.json
# LOG_PATH=/abs/path/calendar_mirror.log
