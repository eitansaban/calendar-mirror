<!--
  Example macOS launchd schedule: run every 2 hours, 6 AM–6 PM, Monday–Friday.
  Edit the three /ABSOLUTE/PATH placeholders, then:

    cp com.example.calendar-mirror.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.example.calendar-mirror.plist

  On Linux, use cron instead, e.g.:
    0 6-18/2 * * 1-5  cd /path/to/calendar-mirror && .venv/bin/python calendar_mirror.py
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.calendar-mirror</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/.venv/bin/python</string>
    <string>/ABSOLUTE/PATH/calendar_mirror.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
